# UMP: скопируй в .env и заполни. .env никогда не коммитится.

# ── режим банка ──
# paper — банк виртуальный: телефоны проходят весь путь, финальное подтверждение пропускается
# live  — реальный банк в приложении pump.fun (старт: npm run launch -- <сумма>)
BANK_MODE=live
# в live подтверждение покупок/продаж включается только при PHONE_DRY_RUN=0.
# Пока карта интерфейса pump.fun не откалибрована — держим 1: телефон проходит весь путь, но не жмёт «купить».
PHONE_DRY_RUN=1
MOCK=0

# ── банк (USD) ──
START_BANK_USD=300
RESERVE_USD=15
MIN_POSITION_USD=5
MAX_POSITION_USD=15
DAILY_LOSS_LIMIT_USD=45
HALT_EQUITY_USD=180
MAX_OPEN_POSITIONS=0          # 0 = без лимита
MAX_ENTRIES_PER_HOUR=0        # 0 = без лимита
MAX_ENTRIES_PER_TICK=3
LOSS_STREAK_PAUSE=0           # 0 = выключено
PUMP_MIN_ORDER_USD=1
FEE_PCT=0.01

# ── фильтры входа ──
PUMPFUN_ONLY=1
MIN_MCAP_USD=100000
MAX_AGE_H=0
MIN_AGE_MIN=0
MIN_VOL_1H_USD=25000
MAX_RUG=0.45
MAX_TOP10=0.35
MAX_BUNDLER=0.35
MAX_SOCIAL_REUSE=5
ENTRY_SCORE=70

# ── выходы ──
STOP_LOSS_PCT=25
TP1_PCT=60
TP1_SELL_PCT=50
TP2_PCT=150
TRAIL_PCT=30
TIME_STOP_H=6
PROFIT_LOCK_PCT=30            # был в плюсе на 30% — стоп переезжает в +5%
PROFIT_LOCK_FLOOR=5
MOON_PCT=100                  # на +100% продаёт половину

# ── ритм ──
TICK_SECONDS=60
EXIT_CHECK_SECONDS=20
RESEARCH_COOLDOWN_MIN=15
PICKS_PER_SCAN=4
REVIEW_EVERY_MIN=20
SYNC_MINUTES=15

# ── мозг (DeepSeek) ──
DEEPSEEK_API_KEY=
LLM_MODEL=

# ── данные: отдельный ключ GMGN (не общий с FOMI и FOMIX) ──
GMGN_API_KEY=

# ── телефоны VMOS: общие ключи + три пада ──
VMOS_AK=
VMOS_SK=
PAD_TRADE=                    # #1 приложение pump.fun с кошельком
PAD_SCOPE=                    # #2 Chrome (gmgn.ai)
PAD_SOCIAL=                   # #3 приложение X с аккаунтом бота
PUMPFUN_PKG=fun.pump.app      # если не так — npm run phone:debug -- 1 покажет настоящее имя
X_PKG=com.twitter.android
CHROME_PKG=com.android.chrome
PHONE_STEP_DELAY_MS=900
CURSOR_LEAD_MS=350
PHONE_FPS_ACTIVE=2
PHONE_FPS_IDLE=0.5
IDLE_BROWSE=1
IDLE_SECONDS=25

# ── X ──
X_HANDLE=ump_ai
X_POST_VIA=phone              # phone | api | off
MAX_TWEETS_PER_HOUR=4
X_USER_TOKEN=                 # только для X_POST_VIA=api или как запасной путь

# ── live-сервер и админка (https://live.<домен>/admin#<ADMIN_TOKEN>) ──
LIVE_PORT=8789
LIVE_ALLOW_ORIGIN=*
ADMIN_TOKEN=                  # 16+ символов

# ── ссылки на сайте ──
SITE_URL=https://umpai.trade
GITHUB_URL=https://github.com/umpai/ump-agent
PUMP_URL=https://pump.fun
CONTRACT_ADDRESS=             # пусто, пока нет официального токена
