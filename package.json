{
  "name": "ump-agent",
  "version": "0.1.0",
  "description": "UMP: an autonomous AI memecoin trader on pump.fun, working three real cloud phones live.",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=18" },
  "scripts": {
    "live": "node brain/live/server.js",
    "brain": "node brain/index.js",
    "tick": "node brain/index.js --once",
    "mock": "MOCK=1 node brain/index.js --once",
    "status": "node brain/cli.js status",
    "admin": "node brain/cli.js admin",
    "sync": "node brain/cli.js sync",
    "launch": "node brain/cli.js launch",
    "fix": "node brain/cli.js fix",
    "playbook": "node brain/cli.js playbook",
    "resume": "node brain/cli.js resume",
    "llm:test": "node brain/cli.js llm-test",
    "stop": "node brain/cli.js stop",
    "unstop": "node brain/cli.js unstop",
    "phone:ping": "node brain/cli.js phone-ping",
    "phone:snap": "node brain/cli.js phone-snap",
    "phone:debug": "node brain/cli.js phone-debug",
    "phone:test": "node brain/cli.js phone-test",
    "scope:test": "node brain/cli.js scope-test",
    "x:check": "node brain/cli.js x-check",
    "x:test": "node brain/cli.js x-test",
    "gmgn:check": "gmgn-cli market trending --chain sol --interval 1h --limit 3",
    "site": "npx --yes serve docs -l 4173"
  },
  "dependencies": { "gmgn-cli": "^1.6.6" }
}
